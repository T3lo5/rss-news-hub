{
  "name": "rss-news-hub",
  "version": "1.0.0",
  "description": "Manual RSS scraper + AI content generator + Telegram distributor",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --import tsx server.js",
    "fetch": "node scripts/fetch.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:watch": "node --import tsx --watch --test",
    "cli": "node --import tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test routes services middleware scripts server.js",
    "lint:fix": "biome check --write src test routes services middleware scripts server.js",
    "format": "biome format --write src test routes services middleware scripts server.js",
    "build:frontend": "cd frontend && npm run build",
    "dev": "bash start-dev.sh",
    "dev:parallel": "concurrently \"npm run start\" \"cd frontend && npm run dev\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.2",
    "openai": "^7.30.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "swagger-ui-dist": "^5.33.2",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}

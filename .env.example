# Environment variables - copy to .env and fill in your values
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.ai/v1
SENSENOVA_MODEL=sensenova-6.8-flash-lite

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

PORT=3000

# Required in production (NODE_ENV=production refuses to boot without it).
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Optional dedicated key for encrypting secrets stored in the DB (AI keys,
# Telegram token / SMTP password set from the admin Settings screen). Falls
# back to JWT_SECRET.
# Generate with: openssl rand -base64 32
# SETTINGS_ENCRYPTION_KEY=

# Optional SMTP for sending the newsletter/digest by e-mail. Can also be set
# from the admin Settings screen (which takes precedence over these values).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM=RSS News Hub <you@example.com>
# Default newsletter/digest recipients (comma separated)
# NEWSLETTER_RECIPIENTS=

# Automatic news retention (admin Settings screen wins over these). Defaults:
# prune anything older than 30 days, and junk below the relevance threshold
# after 7 days. Bookmarked news is never pruned. Set a value to 0 to disable
# that rule.
# NEWS_RETENTION_DAYS=30
# NEWS_LOW_SCORE_THRESHOLD=30
# NEWS_LOW_SCORE_DAYS=7

# The refresh token is stored in an HttpOnly cookie (survives cache clears and
# is unreadable by JS). Set COOKIE_SECURE explicitly to force/disable the
# `Secure` flag; by default it is on in production and off in dev (plain http).
# COOKIE_SECURE=false
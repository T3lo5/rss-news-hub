# Environment variables - copy to .env and fill in your values
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.ai
SENSENOVA_MODEL=sensenova-6.8-flash-lite

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

PORT=3000

# Required in production (NODE_ENV=production refuses to boot without it).
# Generate with: openssl rand -base64 48
JWT_SECRET=
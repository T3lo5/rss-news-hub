# =============================================================================
# RSS News Hub - .gitignore
# =============================================================================
# NOTE: gitignore does not support inline comments. A '#' only starts a comment
# at the beginning of a line, so keep explanations on their own lines.
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
frontend/node_modules/

# -----------------------------------------------------------------------------
# Build outputs
# -----------------------------------------------------------------------------
dist/
build/
# Frontend build output (generated by npm run build:frontend)
public/
# ...exceto o estático de origem do frontend (manifest, ícones, sw.js), que
# não é build e precisa ser versionado para o Docker/Vite copiarem.
!frontend/public/
!frontend/public/**
# TypeScript incremental build cache
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Environment & Secrets (NEVER COMMIT)
# -----------------------------------------------------------------------------
# Contains JWT_SECRET, API keys, tokens
.env
.env.local
.env.*.local
# Producao: gerado por deploy/provision.sh (JWT_SECRET, senhas, chaves de IA).
# O template deploy/.env.prod.example PODE ser versionado.
.env.prod
.env.caddy
.env.production
.env.staging
# SSL certificates
*.pem
# Private keys
*.key

# -----------------------------------------------------------------------------
# Runtime Data (SQLite, logs, cache, exports)
# -----------------------------------------------------------------------------
# SQLite DB (rss-news-hub.db + WAL), JSON exports, cache
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# IDE & Editor
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Testing & Coverage
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
.docker/
docker-compose.override.yml

# -----------------------------------------------------------------------------
# OS & Misc
# -----------------------------------------------------------------------------
*.pid
*.seed
*.pid.lock

# -----------------------------------------------------------------------------
# Package lockfiles (COMMIT THESE - they ensure reproducible installs)
# -----------------------------------------------------------------------------
# package-lock.json        # Keep - commit this
# frontend/package-lock.json  # Keep - commit this

# -----------------------------------------------------------------------------
# Generated documentation
# -----------------------------------------------------------------------------
# Auto-generated API docs (if any)
docs/api/
*.generated.md

# -----------------------------------------------------------------------------
# Temporary files
# -----------------------------------------------------------------------------
tmp/
temp/
.tmp/
*.tmp
*.temp
# Leftover local probe (not part of the project)
test.txt

# -----------------------------------------------------------------------------
# TypeScript / Biome caches
# -----------------------------------------------------------------------------
.biome-cache/
.tscache/

# -----------------------------------------------------------------------------
# Drizzle / Database
# -----------------------------------------------------------------------------
# Drizzle kit output (if using drizzle-kit push)
drizzle/
*.drizzle/

# =============================================================================
# FILES THAT SHOULD BE COMMITTED (for reference)
# =============================================================================
# .env.example             # Template for environment variables
# package.json
# package-lock.json
# frontend/package.json
# frontend/package-lock.json
# biome.json
# tsconfig.json (if exists)
# drizzle.config.ts
# docker-compose.yml
# Dockerfile
# README.md
# AGENTS.md
# All source files in src/, services/, routes/, middleware/, scripts/, test/
# Frontend source in frontend/src/, frontend/*.config.*
# Config files in config/
# Migrations in src/db/migrations/
# Plugins in plugins/

# .env.prod - template do ambiente de producao.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# Ou, melhor: rode deploy/provision.sh, que gera os segredos na propria maquina
# (eles nunca passam por aqui nem por historico de shell).

# --- Segredos da aplicacao (obrigatorios) ------------------------------------

# Sem isso a app MORRE no boot em NODE_ENV=production:
#   Error: JWT_SECRET is required in production
#   openssl rand -base64 48
JWT_SECRET=troque-por-openssl-rand-base64-48

# A app cria o admin automaticamente no boot (server.js -> createDefaultAdmin).
# Sem estes dois, o padrao e' admin@localhost / changeme123 - publicado.
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-forte

# --- Registro de contas ------------------------------------------------------
# Este deploy e' single-admin: o Caddyfile bloqueia POST /api/auth/register
# com 403. Com ALLOW_REGISTRATION=false a tela de login tambem esconde o link
# "Criar conta" (GET /api/auth/config), em vez de exibir um formulario que
# sempre termina em 403. Padrao quando ausente: true (auto-cadastro liberado).
ALLOW_REGISTRATION=false

# --- Basic Auth do Caddy (OPCIONAL, desligado) -------------------------------
#
# O Caddyfile atual NAO usa Basic Auth: ele bloqueia POST /api/auth/register
# com 403 e deixa o app cuidar do login (JWT).
#
# Motivo de ter saido: o Caddy verifica o hash bcrypt a CADA requisicao, porque
# Basic Auth nao tem sessao. Com custo 14 nesta instancia (1/8 de OCPU) isso da
# ~2,8s de CPU por requisicao - a pagina inteira levava ~20s e o navegador
# entrava em loop de popup.
#
# Se algum dia quiser religar, use CUSTO 10 (nao o padrao 14):
#   docker run --rm caddy:2-alpine caddy hash-password --cost 10 --plaintext 'SENHA'
# E lembre do escape: cada "$" do hash vira "$$" quando vai por env_file.
#
# APP_USER=rss
# APP_PASS_HASH=$$2a$$10$$SUBSTITUA_PELO_HASH_BCRYPT

# Dominio com registro A/DNS apontando para o IP publico desta maquina.
#   preenchido -> Caddy emite e renova certificado Let's Encrypt sozinho (443)
#   vazio      -> cai em "localhost" com CA interna; acesso so pela :5678
# Exemplo: rssnewshub.duckdns.org
DOMAIN=

# Tag da imagem carregada com `docker load` (ver README, secao "Atualizar").
IMAGE_TAG=rss-news-hub:amd64

# --- Integracoes (opcionais, copiadas do .env de desenvolvimento) -----------

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Tuning ------------------------------------------------------------------

PORT=3000

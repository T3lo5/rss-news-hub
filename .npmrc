# O runtime usa better-sqlite3@13, que depende de N-API 10 (Node >= 22).
# Em Node 20 o módulo nativo carrega e derruba o processo com SIGSEGV, o que
# aparece como "test failed" sem causa aparente nos logs do CI.
# Falhar no install com mensagem clara é melhor do que descobrir no teste.
engine-strict=true
